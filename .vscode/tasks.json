{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-and-copy",
            "dependsOrder": "sequence",
            "dependsOn": [
                "build",
                "make-plugin-dir",
                "copy-dll"
            ]
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "--configuration=Debug",
                "${workspaceFolder}/${config:pluginName}/${config:pluginName}.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "make-plugin-dir",
            "type": "shell",
            "command": "mkdir",
            "windows": {
                "args": [
                    "-Force",
                    "-Path",
                    "${config:jellyfinWindowsDataDir}/plugins/${config:pluginFolder}/"
                ]
            },
            "linux": {
                "args": [
                    "-p",
                    "${config:jellyfinLinuxDataDir}/plugins/${config:pluginFolder}/"
                ]
            },
            "osx": {
                "args": [
                    "-p",
                    "${config:jellyfinLinuxDataDir}/plugins/${config:pluginFolder}/"
                ]
            }
        },
        {
            "label": "copy-dll",
            "type": "shell",
            "command": "cp",
            "windows": {
                "args": [
                    "${workspaceFolder}/${config:pluginName}/bin/Debug/net10.0/publish/${config:pluginName}.*",
                    "${config:jellyfinWindowsDataDir}/plugins/${config:pluginFolder}/"
                ]
            },
            "linux": {
                "args": [
                    "${workspaceFolder}/${config:pluginName}/bin/Debug/net10.0/publish/${config:pluginName}.dll",
                    "${workspaceFolder}/${config:pluginName}/bin/Debug/net10.0/publish/${config:pluginName}.pdb",
                    "${config:jellyfinLinuxDataDir}/plugins/${config:pluginFolder}/"
                ]
            },
            "osx": {
                "args": [
                    "${workspaceFolder}/${config:pluginName}/bin/Debug/net10.0/publish/${config:pluginName}.dll",
                    "${workspaceFolder}/${config:pluginName}/bin/Debug/net10.0/publish/${config:pluginName}.pdb",
                    "${config:jellyfinLinuxDataDir}/plugins/${config:pluginFolder}/"
                ]
            }
        }
    ]
}
